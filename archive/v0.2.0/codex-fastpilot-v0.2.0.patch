+                    prompt="Inspect this task", schema_path=self.schema, output_path=self.base / "output.json",
+                    timeout_seconds=60, service_tier="priority", speed_profile_name="balanced")
+        args.update(extra)
+        with patch.object(self.runner, "_execute_once", side_effect=self.fake_execute):
+            result = self.runner.execute(**args)
+        return load_json(result.evidence_path)
+
+    def test_background_downgrades_but_explicit_profile_wins(self):
+        evidence = self.run_selection(wait_value="background")
+        self.assertEqual(self.calls[-1]["service_tier"], "default")
+        self.assertEqual(evidence["fast_benefit"]["reason"], "background_wait_value")
+        self.run_selection(wait_value="background", speed_profile_name="all-fast")
+        self.assertEqual(self.calls[-1]["service_tier"], "priority")
+
+    def test_blocking_uses_actual_comparisons_without_an_extra_model_call(self):
+        group = comparison_group("scope", "gpt-test-sol", "max", "worker-test-1", "Inspect this task", self.schema)
+        for tier in ("priority", "default"):
+            for index in range(5):
+                self.history.record(group, f"{tier}-{index}", {"tier": tier, "input_tokens": 8192,
+                    "output_tokens": 256, "cached_input_tokens": 0, "elapsed_seconds": 5})
