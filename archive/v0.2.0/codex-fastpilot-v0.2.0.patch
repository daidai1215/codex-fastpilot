+class BenefitHistoryTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.base = Path(self.tmp.name)
+        self.now = 1_800_000_000.0
+        self.history = FastBenefitHistory(self.base / "history.json", clock=lambda: self.now)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def seed(self, group="g", *, fast=50, standard=50, count=5, incoming=8192, cached=0):
+        for tier, rate in (("priority", fast), ("default", standard)):
+            for index in range(count):
+                self.history.record(group, f"{group}-{tier}-{incoming}-{cached}-{index}", {
+                    "tier": tier, "input_tokens": incoming, "output_tokens": 256,
+                    "cached_input_tokens": cached, "elapsed_seconds": 256 / rate,
+                })
+
+    def test_consistently_small_gain_can_downgrade(self):
+        self.seed(fast=52, standard=50)
+        decision = self.history.choose("g")
+        self.assertTrue(decision["downgrade"])
+        self.assertAlmostEqual(decision["comparisons"][0]["median_gain"], 1.04)
+
+    def test_clear_gain_or_missing_control_keeps_profile(self):
+        self.seed(fast=80, standard=50)
+        self.assertFalse(self.history.choose("g")["downgrade"])
+        self.assertFalse(self.history.choose("unseen")["downgrade"])
+        self.seed("small", count=4)
+        self.assertFalse(self.history.choose("small")["downgrade"])
+
+    def test_context_cache_and_noise_prevent_false_comparison(self):
+        self.seed()
+        self.history.record("g", "different-cache", {
+            "tier": "priority", "input_tokens": 8192, "output_tokens": 256,
+            "cached_input_tokens": 8192, "elapsed_seconds": 8,
+        })
+        self.assertFalse(self.history.choose("g")["downgrade"])
+        self.seed("noisy")
+        value = load_json(self.history.path)
+        fast = [s for s in value["samples"] if s["group"] == "noisy" and s["tier"] == "priority"]
+        for sample, rate in zip(fast, [20, 30, 50, 90, 100]):
+            sample["rate"] = rate
+        atomic_write_json(self.history.path, value)
+        self.assertFalse(self.history.choose("noisy")["downgrade"])
+
+    def test_samples_expire_and_duplicate_acceptance_does_not_inflate_counts(self):
+        self.seed()
+        self.seed()
+        self.assertEqual(len(load_json(self.history.path)["samples"]), 10)
+        self.now += MAX_AGE_SECONDS + 1
+        self.assertFalse(self.history.choose("g")["downgrade"])
+
+    def test_corrupt_history_is_not_silently_replaced(self):
+        self.history.path.write_text("{bad", encoding="utf-8")
+        with self.assertRaises(ValueError):
+            self.history.choose("g")
+        self.assertEqual(self.history.path.read_text(), "{bad")
+
+    def test_provider_and_auth_generation_are_separated_without_secret_output(self):
+        with patch.dict(os.environ, {"CODEX_HOME": str(self.base), "OPENAI_API_KEY": "test-secret-one"}):
+            first = runtime_scope(["codex"], False)
+            os.environ["OPENAI_API_KEY"] = "test-secret-two"
+            second = runtime_scope(["codex"], False)
+        self.assertNotEqual(first, second)
+        self.assertEqual(len(first), 64)
+        self.assertNotIn("test-secret", first)
+        code = "import sys;sys.path.insert(0,sys.argv[1]);from orchestrator.fast_benefit import runtime_scope;print(runtime_scope(['codex'],False))"
+        values = []
+        for seed in ("1", "2"):
+            env = {**os.environ, "PYTHONHASHSEED": seed, "CODEX_HOME": str(self.base)}
+            values.append(subprocess.check_output([sys.executable, "-c", code, str(ROOT / "scripts")], env=env, text=True).strip())
+        self.assertEqual(*values)
+
