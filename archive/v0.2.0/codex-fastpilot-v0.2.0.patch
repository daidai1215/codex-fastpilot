+        self.schema.write_text('{"type":"object"}', encoding="utf-8")
+        self.calls = []
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def fake_execute(self, **kwargs):
+        self.calls.append(kwargs)
+        path = self.base / "invocation.json"
+        atomic_write_json(path, {"fast_degraded": False, "started_at": "fixture"})
+        return RunOutcome(0, False, False, False, "", {"status": "success"}, "", path, "session", True, True)
+
+    def run_selection(self, **extra):
