+class TimingTests(unittest.TestCase):
+    def completion(self, tier="priority", **usage):
+        return json.dumps({"type": "turn.completed", "service_tier": tier, "usage": {
+            "input_tokens": 8192, "output_tokens": 256, "cached_input_tokens": 0, **usage,
+        }})
+
+    def test_single_tool_free_turn_records_real_tier_and_tokens(self):
+        timing = InferenceTiming()
+        timing.observe('{"type":"turn.started"}', 10)
+        timing.observe(self.completion("fast"), 12)
+        self.assertEqual(timing.result()["tier"], "priority")
+        self.assertEqual(timing.result()["elapsed_seconds"], 2)
+
+    def test_tool_time_and_multiple_turns_are_not_training_data(self):
+        for tool in (True, False):
+            with self.subTest(tool=tool):
+                timing = InferenceTiming()
+                timing.observe('{"type":"turn.started"}', 0)
+                if tool:
+                    timing.observe('{"type":"item.started","item":{"type":"command_execution"}}', 1)
+                else:
+                    timing.observe('{"type":"turn.started"}', 1)
+                timing.observe(self.completion(), 10)
+                self.assertIsNone(timing.result())
+
+    def test_missing_tier_cache_or_invalid_usage_is_not_evidence(self):
+        events = [self.completion(None), self.completion(output_tokens=True)]
+        events.append(json.dumps({"type": "turn.completed", "service_tier": "priority", "usage": {
+            "input_tokens": 8192, "output_tokens": 256,
+        }}))
+        for event in events:
+            timing = InferenceTiming()
+            timing.observe('{"type":"turn.started"}', 0)
+            timing.observe(event, 2)
+            self.assertIsNone(timing.result())
+
