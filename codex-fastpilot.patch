+
+    def test_resume_does_not_guess_replayed_context_size(self):
+        self.run_selection(resume_session_id="existing-thread")
+        self.assertEqual(self.calls[-1]["service_tier"], "priority")
+
+    def test_material_reading_plan_is_standard_without_extra_calls_or_sticky_tier(self):
+        evidence = self.run_selection(key="planner-1", planning_materials={"standard_planning": True})
+        self.assertEqual(len(self.calls), 1)
