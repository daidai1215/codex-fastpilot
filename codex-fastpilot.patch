+        atomic_write_json(path, {"fast_degraded": False, "started_at": "fixture"})
+        return RunOutcome(0, False, False, False, "", {"status": "success"}, "", path, "session", True, True)
+
+    def run_selection(self, **extra):
+        args = dict(key="worker-test-1", model="gpt-test-sol", reasoning="max", workspace=self.base,
+                    prompt="Inspect this task", schema_path=self.schema, output_path=self.base / "output.json",
+                    timeout_seconds=60, service_tier="priority", speed_profile_name="balanced")
+        args.update(extra)
+        with patch.object(self.runner, "_execute_once", side_effect=self.fake_execute):
+            result = self.runner.execute(**args)
+        return load_json(result.evidence_path)
+
+    def test_background_downgrades_but_explicit_profile_wins(self):
+        evidence = self.run_selection(wait_value="background")
