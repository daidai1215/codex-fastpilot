-        canonical = store.job_dir / f"result-{task_id}.json"
-        atomic_write_json(canonical, result)
-        store.set_artifact(f"result-{task_id}", canonical)
-        store.set_task(
-            task_id,
-            status="success",
-            result=str(canonical),
-            session_id=session_id,
-            speed_fallback=speed_fallback,
-        )
-        return result
