+class RunnerSelectionTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.base = Path(self.tmp.name)
+        self.store = JobStore.create(self.base / "runs", "sample-job", "inspect", self.base, "balanced")
+        self.history = FastBenefitHistory(self.base / "history.json")
+        self.runner = CodexRunner(["fake-codex"], self.store, benefit_history=self.history, benefit_scope="scope")
+        self.schema = self.base / "schema.json"
+        self.schema.write_text('{"type":"object"}', encoding="utf-8")
+        self.calls = []
+
+    def tearDown(self):
